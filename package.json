{
  "name": "nexus-ai",
  "version": "0.1.0",
  "description": "Native macOS AI assistant with floating overlay",
  "type": "module",
  "author": "Nexus-AI Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/Nexus-AI.git"
  },
  "scripts": {
    "dev": "tauri dev",
    "frontend:dev": "vite",
    "build:frontend": "tsc && vite build",
    "build:backend": "tauri build --bundles app",
    "build:all": "npm run build:frontend && npm run build:backend",
    "preview": "vite preview",
    "tauri": "tauri",
    "lint:frontend": "eslint src",
    "lint:backend": "cd src-tauri && cargo clippy -- -D warnings",
    "lint": "npm run lint:frontend && npm run lint:backend",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" && cd src-tauri && cargo fmt",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" && cd src-tauri && cargo fmt -- --check",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:backend": "cd src-tauri && cargo test",
    "test:all": "vitest run && cd src-tauri && cargo test",
    "validate-build": "npm run lint && npm run format:check && npm run typecheck && npm run build:all"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.71",
    "@ai-sdk/google": "^3.0.64",
    "@ai-sdk/openai": "^3.0.53",
    "@ai-sdk/xai": "^3.0.83",
    "@google-cloud/local-auth": "^3.0.1",
    "@tauri-apps/api": "^2.10.1",
    "ai": "^6.0.168",
    "framer-motion": "^12.38.0",
    "googleapis": "^171.4.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "streamdown": "^2.5.0",
    "zod": "^4.3.6"
  },
  "overrides": {
    "picomatch": ">=4.0.4",
    "lodash-es": ">=4.18.0",
    "vite": "^8.0.5"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "^4.2.3",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.2.2",
    "@tauri-apps/cli": "^2.10.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.2",
    "eslint": "^9.0.0",
    "globals": "^17.4.0",
    "jsdom": "^29.0.1",
    "msw": "^2.12.14",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.2.2",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.0.5",
    "vitest": "^4.1.2"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
