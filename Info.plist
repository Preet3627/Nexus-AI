<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIconFile</key>
    <string>icon</string>
    <key>CFBundleIconName</key>
    <string>AppIcon</string>
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>$(PRODUCT_NAME)</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>$(MARKETING_VERSION)</string>
    <key>CFBundleVersion</key>
    <string>$(CURRENT_PROJECT_VERSION)</string>
    <key>LSApplicationCategoryType</key>
    <string>public.app-category.productivity</string>
    <key>LSMinimumSystemVersion</key>
    <string>$(MACOSX_DEPLOYMENT_TARGET)</string>
    <key>LSUIElement</key>
    <false/>
    <key>NSHumanReadableCopyright</key>
    <string>Copyright © 2026 Nexus-AI. All rights reserved.</string>
    <key>NSPrincipalClass</key>
    <string>NSApplication</string>
    <key>NSSupportsAutomaticTermination</key>
    <true/>
    <key>NSSupportsSuddenTermination</key>
    <true/>
    
    <!-- Privacy Descriptions -->
    <key>NSFaceIDUsageDescription</key>
    <string>Nexus-AI uses Face ID to securely access your conversations and settings.</string>
    <key>NSScreenCaptureUsageDescription</key>
    <string>Nexus-AI needs screen capture to take screenshots and analyze screen content.</string>
    <key>NSMicrophoneUsageDescription</key>
    <string>Nexus-AI uses the microphone for voice input.</string>
    <key>NSCameraUsageDescription</key>
    <string>Nexus-AI uses the camera for video input.</string>
    <key>NSAppleEventsUsageDescription</key>
    <string>Nexus-AI uses Apple Events to work with Calendar, Reminders, and other native macOS apps on your behalf.</string>
    <key>NSCalendarsFullAccessUsageDescription</key>
    <string>Nexus-AI reads your calendar so it can show events and create meetings for you.</string>
    <key>NSRemindersFullAccessUsageDescription</key>
    <string>Nexus-AI creates reminders and alarm-style tasks for you in Reminders.</string>
    
    <!-- App Transport Security -->
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsArbitraryLoads</key>
        <false/>
        <key>NSAllowsLocalNetworking</key>
        <true/>
    </dict>
</dict>
</plist>
